# Backend: FastAPI (uvicorn) en :8000, con los samples de ejemplo.
# La key del LLM y el resto de config entran por variables de entorno
# (LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, LLM_CONCURRENCY — ver backend/app/config.py).
FROM python:3.12-slim
WORKDIR /srv
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY samples ./samples
# pdf_report.py busca el logo en <raíz del repo>/assets (relativo al código:
# /srv/app/pdf_report.py -> parents[2] = /), por eso va en /assets.
COPY assets /assets
ENV SAMPLES_DIR=/srv/samples
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
